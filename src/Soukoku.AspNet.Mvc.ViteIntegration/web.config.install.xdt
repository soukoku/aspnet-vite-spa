<?xml version="1.0"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
	<location path="@id" xdt:Transform="InsertIfMissing" xdt:Locator="Match(path)" >
		<system.web>
			<httpRuntime requestPathInvalidCharacters="&lt;,&gt;,*,%,&amp;,\,?" />
		</system.web>
	</location>
</configuration>